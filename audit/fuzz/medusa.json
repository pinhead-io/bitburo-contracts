{
	"fuzzing": {
		"workers": 10,
		"workerResetLimit": 50,
		"timeout": 600,
		"testLimit": 0,
		"shrinkLimit": 5000,
		"callSequenceLength": 100,
		"pruneFrequency": 5,
		"corpusDirectory": "",
		"coverageEnabled": true,
		"coverageFormats": [
			"html",
			"lcov"
		],
		"coverageExclusions": [],
		"revertReporterEnabled": false,
		"targetContracts": [
			"RebalancerHarness"
		],
		"predeployedContracts": {},
		"targetContractsBalances": [],
		"constructorArgs": {},
		"deployerAddress": "0x30000",
		"senderAddresses": [
			"0x10000",
			"0x20000",
			"0x30000"
		],
		"blockNumberDelayMax": 1800,
		"blockTimestampDelayMax": 3600,
		"transactionGasLimit": 30000000,
		"testing": {
			"stopOnFailedTest": false,
			"stopOnFailedContractMatching": false,
			"stopOnNoTests": true,
			"testAllContracts": false,
			"testViewMethods": true,
			"verbosity": 1,
			"assertionTesting": {
				"enabled": false
			},
			"propertyTesting": {
				"enabled": true,
				"testPrefixes": [
					"property_"
				]
			},
			"optimizationTesting": {
				"enabled": false
			},
			"targetFunctionSignatures": [],
			"excludeFunctionSignatures": []
		},
		"chainConfig": {
			"codeSizeCheckDisabled": true,
			"cheatCodes": {
				"cheatCodesEnabled": true,
				"enableFFI": false
			},
			"skipAccountChecks": true
		}
	},
	"compilation": {
		"platform": "crytic-compile",
		"platformConfig": {
			"target": "audit/fuzz/RebalancerHarness.sol",
			"solcVersion": "",
			"exportDirectory": "",
			"args": [
				"--compile-force-framework",
				"solc",
				"--solc-working-dir",
				"../.."
			]
		}
	},
	"slither": {
		"useSlither": false,
		"cachePath": "",
		"args": []
	},
	"logging": {
		"level": "info",
		"logDirectory": "",
		"noColor": true
	}
}
